# Airflow REST API Configuration
AIRFLOW_BASE_URL=http://localhost:8080/api/v2
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow

# Dashboard Middleware & Cache Settings
CACHE_TTL_SECONDS=15
USE_MOCK_FALLBACK=True
AIRFLOW_VERIFY_SSL=False

# Google Gemini LLM API Key (Optional for AI Error Diagnosis & ChatOps)
GEMINI_API_KEY=your_gemini_api_key_here

# Automated Email Failure Alerting Settings (Approach 2)
ENABLE_EMAIL_ALERTS=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT_EMAILS=alerts@company.com,team@company.com
